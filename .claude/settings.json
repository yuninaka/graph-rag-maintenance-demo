{
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(chmod 777 *)",
      "Bash(git config --global *)",
      "Bash(git push --force*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-env-commit.sh"
          }
        ]
      }
    ]
  }
}
